{
  "name": "pcybox-orbis",
  "version": "1.0.0",
  "description": "Real-time network traffic visualizer",
  "main": "main.js",
  "author": "Pcybox | Ibrahima Khalilou lahi SAMB",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pcybox.orbis",
    "productName": "PCYBOX Orbis",
    "directories": {
      "output": "../dist/installer"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "icon.png",
        "to": "icon.png"
      },
      {
        "from": "../dist/backend/pcybox-orbis-backend.exe",
        "to": "pcybox-orbis-backend.exe"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend_dist"
      },
      {
        "from": "../resources/npcap-installer.exe",
        "to": "npcap-installer.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PCYBOX Orbis"
    }
  }
}
